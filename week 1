<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Class Timetable</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #333;
        }

        header {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: white;
            text-align: center;
            padding: 30px 15px;
        }

        header h1 {
            font-size: 32px;
            margin-bottom: 8px;
        }

        header p {
            font-size: 16px;
        }

        .container {
            width: 95%;
            max-width: 1200px;
            margin: 30px auto;
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 800px;
        }

        th {
            background: #4f46e5;
            color: white;
            padding: 15px;
            font-size: 15px;
        }

        td {
            text-align: center;
            padding: 14px;
            border: 1px solid #ddd;
            font-weight: 500;
        }

        .time {
            background: #eef2ff;
            color: #4338ca;
            font-weight: bold;
        }

        .math {
            background: #fee2e2;
            color: #991b1b;
        }

        .science {
            background: #dcfce7;
            color: #166534;
        }

        .english {
            background: #dbeafe;
            color: #1e40af;
        }

        .computer {
            background: #fef3c7;
            color: #92400e;
        }

        .break {
            background: #f3f4f6;
            color: #6b7280;
            font-weight: bold;
        }

        tr:hover td {
            background-color: #f8fafc;
        }

        footer {
            text-align: center;
            padding: 20px;
            color: #777;
            font-size: 14px;
        }

        @media (max-width: 600px) {
            header h1 {
                font-size: 25px;
            }

            .container {
                padding: 10px;
            }

            th, td {
                padding: 10px;
                font-size: 13px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>📚 Class Timetable</h1>
        <p>Weekly Schedule - Academic Year 2026</p>
    </header>

    <div class="container">

        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Monday</th>
                    <th>Tuesday</th>
                    <th>Wednesday</th>
                    <th>Thursday</th>
                    <th>Friday</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td class="time">9:00 - 10:00</td>
                    <td class="math">Mathematics</td>
                    <td class="science">Science</td>
                    <td class="english">English</td>
                    <td class="computer">Computer</td>
                    <td class="math">Mathematics</td>
                </tr>

                <tr>
                    <td class="time">10:00 - 11:00</td>
                    <td class="english">English</td>
                    <td class="math">Mathematics</td>
                    <td class="science">Science</td>
                    <td class="english">English</td>
                    <td class="computer">Computer</td>
                </tr>

                <tr>
                    <td class="time">11:00 - 11:30</td>
                    <td colspan="5" class="break">☕ BREAK</td>
                </tr>

                <tr>
                    <td class="time">11:30 - 12:30</td>
                    <td class="science">Science</td>
                    <td class="computer">Computer</td>
                    <td class="math">Mathematics</td>
                    <td class="science">Science</td>
                    <td class="english">English</td>
                </tr>

                <tr>
                    <td class="time">12:30 - 1:30</td>
                    <td class="computer">Computer</td>
                    <td class="english">English</td>
                    <td class="computer">Computer</td>
                    <td class="math">Mathematics</td>
                    <td class="science">Science</td>
                </tr>

                <tr>
                    <td class="time">1:30 - 2:30</td>
                    <td colspan="5" class="break">🍴 LUNCH BREAK</td>
                </tr>

                <tr>
                    <td class="time">2:30 - 3:30</td>
                    <td class="english">English</td>
                    <td class="science">Science</td>
                    <td class="computer">Computer</td>
                    <td class="math">Mathematics</td>
                    <td class="computer">Computer</td>
                </tr>

            </tbody>
        </table>

    </div>

    <footer>
        © 2026 Class Timetable | All Rights Reserved
    </footer>

</body>
</html>
